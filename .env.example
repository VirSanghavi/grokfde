# Copy to .env.local and fill in. Never commit real secrets.
# This repo is open source — only placeholders belong in git.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prefer the service_role / secret key for server routes
SUPABASE_SERVICE_ROLE_KEY=

# xAI (https://console.x.ai)
XAI_API_KEY=
# Optional: Management key with Collections permissions
# https://console.x.ai/team/default/settings/management-keys
XAI_MANAGEMENT_API_KEY=

XAI_TEXT_MODEL=grok-4.5
XAI_VOICE_MODEL=grok-voice-latest
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VIDEO_MODEL=grok-imagine-video

# Optional email (Resend)
EMAIL_API_KEY=
EMAIL_FROM=
RESEND_API_KEY=

# Person A mock UI mode (server ignores this)
NEXT_PUBLIC_MOCK_AI=false

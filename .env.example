# Copy to .env.local — never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# xAI / Grok
XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=
XAI_TEXT_MODEL=grok-4.5
XAI_VOICE_MODEL=grok-voice-latest
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VIDEO_MODEL=grok-imagine-video

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# false = real APIs; true = Person A mock layer
NEXT_PUBLIC_MOCK_AI=false

# Email (optional)
EMAIL_API_KEY=
EMAIL_FROM=
RESEND_API_KEY=

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
ALLOW_DEMO_SLACK=true

# GitHub (optional for real repo adapter)
GITHUB_TOKEN=
